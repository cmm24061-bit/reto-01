# Proveedor del modelo: "anthropic" (por defecto) o "simulado" (guion fijo, sin modelo, para probar sin clave)
LLM_PROVIDER=anthropic
# Clave de Anthropic. Solo en el servidor. NUNCA en el repositorio ni en el front.
ANTHROPIC_API_KEY=
# Modelo a usar
LLM_MODEL=claude-sonnet-5-5
# Tiempo máximo de espera al modelo (ms)
LLM_TIMEOUT_MS=90000
# Topes de costo
MAX_ITERACIONES=25
MAX_TOKENS_SESION=300000
MAX_TOKENS_GLOBAL=3000000
# Opcional: si se define, el chat pide esta clave para poder usarse
APP_ACCESS_KEY=
# Opcional: fija la fecha de ejecución (YYYY-MM-DD) para pruebas reproducibles de vigencias
FECHA_REFERENCIA=
# Puerto HTTP
PORT=3000
